# Lumin — Environment Variables Example
#
# Copy this file to .env and fill in real values before starting services.
# NEVER commit .env to version control.
#
# Secret generation:
#   JWT_SECRET:    openssl rand -hex 64
#   TURN_SECRET:   openssl rand -hex 32
#   MEDIA_SECRET:  openssl rand -hex 32
#   POSTGRES_PASSWORD: openssl rand -hex 32

# Database
POSTGRES_DB=lumin
POSTGRES_USER=lumin
POSTGRES_PASSWORD=CHANGE_ME_strong_random
DATABASE_URL=postgresql+asyncpg://lumin:CHANGE_ME_strong_random@postgres:5432/lumin

# Redis
REDIS_URL=redis://redis:6379/0
SIGNALING_REDIS_URL=redis://redis:6379/1

# JWT  (signaling server shares JWT_SECRET to verify tokens)
JWT_SECRET=CHANGE_ME_openssl_rand_hex_64
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# TURN
TURN_SECRET=CHANGE_ME_openssl_rand_hex_32
TURN_HOST=lumin.example.com

# Media
MEDIA_SECRET=CHANGE_ME_openssl_rand_hex_32
MEDIA_BASE_PATH=/app/media
MAX_IMAGE_SIZE_MB=15
MAX_VIDEO_SIZE_MB=150
MAX_DOCUMENT_SIZE_MB=25
MAX_AVATAR_SIZE_MB=5

# Firebase Cloud Messaging (push notifications)
# 1. Create a Firebase project at https://console.firebase.google.com
# 2. Project settings → Service accounts → Generate new private key
# 3. Save as firebase-service-account.json in the project root (gitignored)
# 4. Set FIREBASE_PROJECT_ID to the "project_id" field inside that JSON file
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=/app/firebase-service-account.json

# App
APP_ENV=production
DEBUG=false
DOMAIN=lumin.example.com            # TODO: replace domain
OTP_TTL_SECONDS=300

# Comma-separated admin emails — these accounts can view support requests
# at GET /api/support/requests (JSON) and /api/support/requests/view (HTML).
# Case-insensitive. Leave empty to disable admin access entirely.
ADMIN_EMAILS=

# Optional shared password for the browser support-admin page
# (/api/support/requests/view). The browser shows a Basic-auth login: use an
# ADMIN_EMAILS address as the username and this value as the password. Leave
# empty to instead require each admin's own Lumio account password.
ADMIN_PANEL_PASSWORD=

# ── Monitoring (Grafana) ──────────────────────────────────────────────────────
# Login for the Grafana dashboard (bound to 127.0.0.1:3000 on the server; reach
# it via an SSH tunnel). If unset, defaults to admin/admin and Grafana forces a
# password change on first login. Set a strong password for unattended deploys.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
