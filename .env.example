# FamilyLink — Environment Variables Example
#
# Copy this file to .env and fill in real values before starting services.
# NEVER commit .env to version control.
#
# Secret generation:
#   JWT_SECRET:    openssl rand -hex 64
#   TURN_SECRET:   openssl rand -hex 32
#   MEDIA_SECRET:  openssl rand -hex 32
#   POSTGRES_PASSWORD: openssl rand -hex 32

# Database
POSTGRES_DB=familyapp
POSTGRES_USER=familyapp
POSTGRES_PASSWORD=CHANGE_ME_strong_random
DATABASE_URL=postgresql+asyncpg://familyapp:CHANGE_ME_strong_random@postgres:5432/familyapp

# Redis
REDIS_URL=redis://redis:6379/0
SIGNALING_REDIS_URL=redis://redis:6379/1

# JWT  (signaling server shares JWT_SECRET to verify tokens)
JWT_SECRET=CHANGE_ME_openssl_rand_hex_64
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# TURN
TURN_SECRET=CHANGE_ME_openssl_rand_hex_32
TURN_HOST=family.example.com

# Media
MEDIA_SECRET=CHANGE_ME_openssl_rand_hex_32
MEDIA_BASE_PATH=/app/media
MAX_IMAGE_SIZE_MB=15
MAX_VIDEO_SIZE_MB=150
MAX_DOCUMENT_SIZE_MB=25
MAX_AVATAR_SIZE_MB=5

# Firebase
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=/app/firebase-service-account.json

# App
APP_ENV=production
DEBUG=false
DOMAIN=family.example.com           # TODO: replace domain
OTP_TTL_SECONDS=300
