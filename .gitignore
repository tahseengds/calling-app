# Secrets — never commit
.env
firebase-service-account.json
google-services.json

# Raw Claude Code session transcripts.
# These contain every tool result verbatim, including config files, JWTs,
# and API keys. Always run docs/sessions/sanitize.ps1 (or equivalent
# regex pass — see docs/sessions/README.md) before committing. Sanitized
# JSONLs under docs/sessions/ are explicitly allowed via the exception
# below.
*.jsonl
!docs/sessions/*.jsonl

# Python
*.pyc
__pycache__/

# Node
node_modules/

# Flutter / Dart
.dart_tool/
build/
# Note: *.g.dart files are committed (generated code is checked in for reproducibility)

# Media uploads
/backend/api/media/

# Logs
*.log

# Local Redis snapshot from running redis-server in-repo during tests
dump.rdb
